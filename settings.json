{
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m -Xlog:disable",
    "workbench.colorTheme": "Default Dark+",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorCustomizations": {
      "debugConsole.infoForeground": "#ffffff"
    },
    "workbench.startupEditor": "none",
    "problems.decorations.enabled": false,
    "security.workspace.trust.enabled": false,
    "redhat.telemetry.enabled": false,
    "spring-boot.ls.problem.version-validation.UPDATE_LATEST_PATCH_VERSION": "IGNORE",
    "extensions.ignoreRecommendations" : true,
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "disabled",
    "java.server.launchMode": "Standard",
    "boot-java.rewrite.reconcile": true,
    "java.completion.filteredTypes": [
      "java.awt.*",
      "com.sun.*",
      "sun.*",
      "jdk.*",
      "org.graalvm.*",
      "io.micrometer.shaded.*",
      "com.aspose.*",
      "groovyjarjarantlr.*"
    ],
    "launch": {
      "compounds": [
        {
          "name": "Flowable",
          "configurations": ["Flowable Work", "Flowable Design"],
          "stopAll": false
        }
      ],
      "configurations": [
        {
          "type": "java",
          "name": "Flowable Work",
          "request": "launch",
          "cwd": "${workspaceFolder}/training-handson-work/target",
          "console": "internalConsole",
          "mainClass": "com.flowable.training.handson.work.TrainingHandsOnWorkApplication",
          "args": "--spring.profiles.active=postgres --spring.output.ansi.enabled=always",
          "projectName": "training-hands-on-work"
        },
        {
          "type": "java",
          "name": "Flowable Design",
          "request": "launch",
          "cwd": "${workspaceFolder}",
          "console": "internalConsole",
          "mainClass": "com.flowable.training.handson.design.TrainingHandsOnDesignApplication",
          "args": "--spring.profiles.active=postgres --spring.output.ansi.enabled=always",
          "projectName": "training-hands-on-design"
        },
        {
          "type": "java",
          "name": "Flowable Control",
          "request": "launch",
          "cwd": "${workspaceFolder}",
          "console": "internalConsole",
          "mainClass": "com.flowable.training.handson.control.TrainingHandsOnControlApplication",
          "args": "--spring.profiles.active=local --spring.output.ansi.enabled=always",
          "projectName": "training-hands-on-control"
        }
      ]
    }
}